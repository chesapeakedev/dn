      "permissions": {
        "contents": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.init_stack"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id", "milestone"],
        "optional": ["refresh", "validate_only"]
      },
      "compatibility_notes": "Requires .github/dn/config.json (dn init workflows --agent) and chesapeakedev/dn-action with workflow execution support. Writes plans/{owner}_{repo}_{milestone}.stack.md and plans/{owner}_{repo}_{milestone}.stack.json."
    },
    {
      "id": "dn.prep_issue_plan",
      "version": "2.0.0",
      "source_path": "templates/workflows/dn-prep-issue-plan.yml",
