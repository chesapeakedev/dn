      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": [],
        "workflow_dispatch": true,
        "schedule": ["17 13 * * *"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": [],
        "optional": ["milestone"]
      },
      "compatibility_notes": "Requires .github/dn/config.json and a committed plans/{owner}_{repo}_{milestone}.stack.md from dn init stack. Scheduled runs read DN_DAILY_KICKSTART_MILESTONE; manual workflow_dispatch can pass milestone. Runs dn kickstart --awp --milestone <milestone> --once."
    }
  ]
}
