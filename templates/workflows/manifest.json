      "payload": {
        "required": ["schema_version", "dispatch_id"],
        "optional": ["issue_url", "issue_number", "awp"]
      },
      "compatibility_notes": "Requires .github/dn/config.json. Provide exactly one of issue_url or issue_number. awp defaults to true. Set the secret for your configured agent only."
    },
    {
      "id": "dn.daily_kickstart",
      "version": "1.0.0",
      "source_path": "templates/workflows/dn-daily-kickstart.yml",
      "install_path": ".github/workflows/dn-daily-kickstart.yml",
