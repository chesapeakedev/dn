{
  "schema_version": "1.0",
  "templates": [
    {
      "id": "dn.init_stack",
      "version": "2.0.0",
      "source_path": "templates/workflows/dn-init-stack.yml",
      "install_path": ".github/workflows/dn-init-stack.yml",
      "checksum": "sha256:be7612cabaead1aa9d978b40a51b6c937484c577e4f9025b2c5792c2cf629875",
