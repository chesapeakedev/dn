{
  "schema_version": "1.0",
  "templates": [
    {
      "id": "dn.init_stack",
      "version": "3.0.0",
      "source_path": "templates/workflows/dn-init-stack.yml",
      "install_path": ".github/workflows/dn-init-stack.yml",
      "checksum": "sha256:766148f5919399f058644e79eeedf44c20c53f35803dfd87002472a37c0adad9",
      "latest_version": "3.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.init_stack"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id", "milestone"],
        "optional": [
          "refresh",
          "stack_mode",
          "publish",
          "validate_only"
        ]
      },
      "compatibility_notes": "Requires .github/dn/config.json and chesapeakedev/dn-action. Writes and commits plans/{owner}_{repo}_{milestone}.stack.{md,json} when publish defaults to direct in CI. stack_mode refresh preserves completed checklist items; refresh=true maps to refresh, refresh=false maps to create."
    },
    {
      "id": "dn.meld_issue_plan",
      "version": "3.0.0",
      "source_path": "templates/workflows/dn-meld-issue-plan.yml",
      "install_path": ".github/workflows/dn-prep-issue-plan.yml",
      "checksum": "sha256:f92a77cabd58f8b49e0996f775ac0d18898eb5272c09d405096110babdab1a3f",
      "latest_version": "3.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.meld_issue_plan", "dn.prep_issue_plan"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id"],
        "optional": ["issue_url", "issue_number", "plan_name", "validate_only"]
      },
      "compatibility_notes": "Requires .github/dn/config.json. Provide exactly one of issue_url or issue_number. The installed workflow also accepts the legacy dn.prep_issue_plan event and temporarily retains the legacy install filename for Denoise compatibility."
    },
    {
      "id": "dn.kickstart_issue",
      "version": "3.0.0",
      "source_path": "templates/workflows/dn-kickstart-issue.yml",
      "install_path": ".github/workflows/dn-kickstart-issue.yml",
      "checksum": "sha256:38853276df492a138f70c34fb7ca25ff415ce530a46ceab9acf9e870cdf44bb0",
      "latest_version": "3.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.kickstart_issue"],
        "labels": ["denoise-build", "cursor awp", "opencode awp"],
        "comments": ["/dn kickstart"]
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id"],
        "optional": [
          "issue_url",
          "issue_number",
          "publish",
          "awp",
          "validate_only"
        ]
      },
      "compatibility_notes": "Requires .github/dn/config.json. Provide exactly one of issue_url or issue_number. publish defaults to pr; awp=true|false maps to pr|none for compatibility. publish=direct commits to the default branch without opening a PR."
    },
    {
      "id": "dn.daily_kickstart",
      "version": "3.0.0",
      "source_path": "templates/workflows/dn-daily-kickstart.yml",
      "install_path": ".github/workflows/dn-daily-kickstart.yml",
      "checksum": "sha256:eca401d0cea3af30b401f34faf4d5b079b6183d45a0ee1769d13e4b49ca95109",
      "latest_version": "3.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": [],
        "workflow_dispatch": true,
        "schedule": ["17 13 * * *"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": [],
        "optional": ["milestone", "validate_only"]
      },
      "compatibility_notes": "Requires .github/dn/config.json and a committed plans/{owner}_{repo}_{milestone}.stack.md from dn init stack. Runs dn kickstart --publish pr --milestone <milestone> --once and commits stack progress to the default branch."
    },
    {
      "id": "dn.todo_loop",
      "version": "1.0.0",
      "source_path": "templates/workflows/dn-todo-loop.yml",
      "install_path": ".github/workflows/dn-todo-loop.yml",
      "checksum": "sha256:6c6549a6bbc38b9ebfc8a77b12f892bd5f0fe37815f1c82aec6783822c119634",
      "latest_version": "1.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.31",
      "permissions": {
        "contents": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": [],
        "workflow_dispatch": true,
        "schedule": ["0 9 * * *"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": [],
        "optional": ["plan_file", "validate_only"]
      },
      "compatibility_notes": "Requires .github/dn/config.json and a plans/todo.plan.md file. Runs dn loop <path> to iterate on the todo list. Schedule defaults to daily at 09:00 UTC."
    }
  ]
}
