    {
      "id": "dn.kickstart_issue",
      "version": "1.0.0",
      "source_path": "templates/workflows/dn-kickstart-issue.yml",
      "install_path": ".github/workflows/dn-kickstart-issue.yml",
      "checksum": "sha256:ef0bcf7dae034c5213646795d92f4aa27c83f1f9370ca5a9b34ef0e31e990052",
      "latest_version": "1.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.21",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.kickstart_issue"],
        "labels": ["denoise-build", "cursor awp", "opencode awp"],
        "comments": ["/dn kickstart"]
