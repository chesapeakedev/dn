        "optional": ["refresh"]
      },
      "compatibility_notes": "Requires .github/dn/config.json (dn init workflows --agent). Writes plans/{owner}_{repo}_{milestone}.stack.md and plans/{owner}_{repo}_{milestone}.stack.json."
