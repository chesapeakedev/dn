      "compatibility_notes": "Requires .github/dn/config.json. Provide exactly one of issue_url or issue_number."
    },
    {
      "id": "dn.kickstart_issue",
      "version": "2.0.0",
      "source_path": "templates/workflows/dn-kickstart-issue.yml",
      "install_path": ".github/workflows/dn-kickstart-issue.yml",
      "checksum": "sha256:4adaddebb9292948c085ae4d04ad8df2d54226e7dcb17582a260622d56bcc022",
      "latest_version": "2.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.kickstart_issue"],
        "labels": ["denoise-build", "cursor awp", "opencode awp"],
        "comments": ["/dn kickstart"]
