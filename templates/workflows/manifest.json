{
  "schema_version": "1.0",
  "templates": [
    {
      "id": "dn.init_stack",
      "version": "4.0.0",
      "source_path": "templates/workflows/dn-init-stack.yml",
      "install_path": ".github/workflows/dn-init-stack.yml",
      "checksum": "sha256:b92ceb35cff5dfc6ec6f99fb1eb163cad154ba09308e6c914524d42a7d6d1fce",
      "latest_version": "4.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.init_stack"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id", "milestone"],
        "optional": [
          "refresh",
          "stack_mode",
          "publish",
          "validate_only"
        ]
      },
      "compatibility_notes": "Requires .github/dn/config.json and chesapeakedev/dn-action. Opens or advances a stable pull request containing plans/{owner}_{repo}_{milestone}.stack.{md,json}. Canonical Actions dispatches accept only publish=pr. stack_mode refresh preserves completed checklist items; refresh=true maps to refresh, refresh=false maps to create."
    },
    {
      "id": "dn.meld_issue_plan",
      "version": "4.1.0",
      "source_path": "templates/workflows/dn-meld-issue-plan.yml",
      "install_path": ".github/workflows/dn-prep-issue-plan.yml",
      "checksum": "sha256:5aed68c49d6ef09cbf148c981ccdc1343628b6d35c9d2a4f3e5fef59369d1537",
      "latest_version": "4.1.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "read",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.meld_issue_plan", "dn.prep_issue_plan"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id"],
        "optional": [
          "issue_url",
          "issue_number",
          "plan_name",
          "validate_only",
          "progress"
        ]
      },
      "compatibility_notes": "Requires .github/dn/config.json. Provide exactly one of issue_url or issue_number. Optional nested progress {mode,url,token} enables live denoise phase/step ingest when KICKSTART_PROGRESS_BASE_URL is configured. Updates the source issue body through the GitHub API and does not push repository content. The installed workflow also accepts the legacy dn.prep_issue_plan event and temporarily retains the legacy install filename for Denoise compatibility."
    },
    {
      "id": "dn.kickstart_issue",
      "version": "4.1.0",
      "source_path": "templates/workflows/dn-kickstart-issue.yml",
      "install_path": ".github/workflows/dn-kickstart-issue.yml",
      "checksum": "sha256:9261107ce037487e35295014d3f0f846bff6550a999180b7f838e7f10881ce61",
      "latest_version": "4.1.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.kickstart_issue"],
        "labels": ["denoise-build", "cursor awp", "opencode awp"],
        "comments": ["/dn kickstart"]
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id"],
        "optional": [
          "issue_url",
          "issue_number",
          "publish",
          "awp",
          "validate_only",
          "progress"
        ]
      },
      "compatibility_notes": "Requires .github/dn/config.json. Provide exactly one of issue_url or issue_number. Optional nested progress {mode,url,token} enables live denoise phase/step ingest (same contract as exe.dev and Cursor Cloud). Canonical Actions dispatches always publish a pull request: publish may be omitted or set to pr, and awp may be omitted or true. Local CLI invocations continue to support none and direct."
    },
    {
      "id": "dn.daily_kickstart",
      "version": "4.0.0",
      "source_path": "templates/workflows/dn-daily-kickstart.yml",
      "install_path": ".github/workflows/dn-daily-kickstart.yml",
      "checksum": "sha256:87e7eb442d939c4d2ed44e889633079f286306798564fffba6260caffa000c2e",
      "latest_version": "4.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.30",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": [],
        "workflow_dispatch": true,
        "schedule": ["17 13 * * *"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": [],
        "optional": ["milestone", "validate_only"]
      },
      "compatibility_notes": "Requires .github/dn/config.json and a committed plans/{owner}_{repo}_{milestone}.stack.md from dn init stack. Runs dn kickstart --publish pr --milestone <milestone> --once. The implementation and stack progress are committed to one pull request; a later run skips while that issue's pull request remains open."
    },
    {
      "id": "dn.todo_loop",
      "version": "3.0.0",
      "source_path": "templates/workflows/dn-todo-loop.yml",
      "install_path": ".github/workflows/dn-todo-loop.yml",
      "checksum": "sha256:db4e71eecb43237eddc0f6bf25cf32793df2b3ee31e00142c0ecfee6890c4a04",
      "latest_version": "3.0.0",
      "deprecated": false,
      "deprecation_message": null,
      "minimum_dn_version": "0.0.31",
      "permissions": {
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_secrets": [],
      "optional_secrets": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "CURSOR_API_KEY"
      ],
      "triggers": {
        "repository_dispatch": ["dn.todo_loop"],
        "workflow_dispatch": true,
        "schedule": ["0 9 * * *"],
        "labels": [],
        "comments": []
      },
      "payload_schema_version": "1.0",
      "payload": {
        "required": ["schema_version", "dispatch_id"],
        "optional": ["plan_file", "validate_only", "progress"]
      },
      "compatibility_notes": "Requires .github/dn/config.json and a plans/todo.plan.md file. Supports schedule, workflow_dispatch, and repository_dispatch (dn.todo_loop) for denoise web starts. Optional nested progress enables live phase/step ingest. Runs dn loop <path> on a stable automation branch and opens or advances one recurring pull request for that plan. Schedule defaults to daily at 09:00 UTC."
    }
  ]
}
