[23.991, "o", "\r\n"]
[24.341, "o", "dn kickstart - Run full kickstart workflow\r\n"]
[24.386, "o", "\r\n"]
[24.431, "o", "Usage:\r\n"]
[24.476, "o", "  dn kickstart [options] <issue_url_or_number_or_markdown_file>\r\n"]
[24.521, "o", "\r\n"]
[24.566, "o", "Argument: GitHub issue URL, issue number for current repo, or path to a .md file.\r\n"]
[24.611, "o", "A path to a markdown file uses that file as context (no GitHub fetch). AWP is not used when context is from a file.\r\n"]
[24.656, "o", "\r\n"]
[24.701, "o", "Options:\r\n"]
[24.746, "o", "  --publish <none|pr|direct> How to publish changes (default: none)\r\n"]
[24.791, "o", "  --awp                    Alias for --publish pr (branches, commits, PRs)\r\n"]
[24.836, "o", "  --allow-cross-repo       Allow implementing issues from different repositories\r\n"]
[24.881, "o", "  --cursor, -c              Use Cursor headless agent\r\n"]
[24.926, "o", "  --cursor-cloud            Queue a durable Cursor Cloud Agent run (requires CURSOR_API_KEY)\r\n"]
[24.971, "o", "  --ref <git-ref>           Cloud repository starting ref (default: main; requires --cursor-cloud)\r\n"]
[25.016, "o", "  --claude                  Use Claude Code CLI (`claude -p`)\r\n"]
[25.061, "o", "  --codex                   Use Codex CLI (`codex exec`)\r\n"]
[25.106, "o", "  --copilot                 Use GitHub Copilot CLI (`copilot -p`)\r\n"]
[25.151, "o", "  --opencode                Use OpenCode CLI (default)\r\n"]
[25.196, "o", "  --sandbox <none|docker|exe.dev>  Sandbox provider (global --sandbox also supported)\r\n"]
[25.241, "o", "  --milestone <url-or-num>  Use milestone-linked stack file (plans/{owner}_{repo}_{milestone}.stack.md)\r\n"]
[25.286, "o", "  --complete               With --milestone only: run all unchecked stack tasks without y/n prompts between them\r\n"]
[25.331, "o", "  --once                   With --milestone only: run one unchecked stack task without y/n prompts\r\n"]
[25.376, "o", "  --saved-plan <name>      Use a specific plan name\r\n"]
[25.421, "o", "  --workspace-root <path>  Workspace root directory\r\n"]
[25.466, "o", "  --help, -h               Show this help message\r\n"]
[25.511, "o", "\r\n"]
[26.361, "o", ""]
[26.761, "o", "\u001b[2m# Ready when you are:  dn kickstart <issue>\u001b[0m\r\n"]
[27.411, "o", ""]
[28.411, "o", ""]
