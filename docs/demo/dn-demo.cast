[4.853, "o", "\r\n"]
[5.203, "o", "dn - A CLI for managing agentic workflows\r\n"]
[5.248, "o", "\r\n"]
[5.293, "o", "Usage:\r\n"]
[5.338, "o", "  dn [global options] <subcommand> [options]\r\n"]
[5.383, "o", "\r\n"]
[5.428, "o", "Global options:\r\n"]
[5.473, "o", "  --agent <agent>   Agent to use for agent-backed workflows (opencode, cursor, claude, codex, copilot)\r\n"]
[5.518, "o", "  --opencode        Alias for --agent opencode\r\n"]
[5.563, "o", "  --cursor          Alias for --agent cursor\r\n"]
[5.608, "o", "  --claude          Alias for --agent claude\r\n"]
[5.653, "o", "  --codex           Alias for --agent codex\r\n"]
[5.698, "o", "  --copilot         Alias for --agent copilot\r\n"]
[5.743, "o", "  --sandbox <none|docker|exe.dev>  Sandbox provider (omit value to read config)\r\n"]
[5.788, "o", "  --unattended      Disable interactive output affordances\r\n"]
[5.833, "o", "  --no-color        Disable color output\r\n"]
[5.878, "o", "  --color           Force color output\r\n"]
[5.923, "o", "  --version, -V     Print the version and exit\r\n"]
[5.968, "o", "\r\n"]
[6.013, "o", "Subcommands:\r\n"]
[6.058, "o", "  auth         Sign in to GitHub in the browser (caches token for dn)\r\n"]
[6.103, "o", "  context      Inspect inherited AGENTS.md context for a file or directory\r\n"]
[6.148, "o", "  init         Initialize repo context (stack, workflows, agents)\r\n"]
[6.193, "o", "    stack      Initialize stack context from GitHub milestone\r\n"]
[6.238, "o", "    build      Install GitHub Actions workflow automation\r\n"]
[6.283, "o", "    workflows  Install canonical GitHub Actions workflows\r\n"]
[6.328, "o", "    agents     Update AGENTS.md with dn instructions\r\n"]
[6.373, "o", "  issue        Manage GitHub issues and relationships\r\n"]
[6.418, "o", "  workflows    Run, install, and manage GitHub Actions workflows\r\n"]
[6.463, "o", "  kickstart    Run full kickstart workflow (plan + implement)\r\n"]
[6.508, "o", "  loop         Run loop phase only (requires plan file from meld)\r\n"]
[6.553, "o", "  until        Run bounded generator/verifier gambits until done\r\n"]
[6.598, "o", "  fixup        Address PR feedback locally (fetch comments, plan, implement)\r\n"]
[6.643, "o", "  glance       Project velocity overview\r\n"]
[6.688, "o", "  peek         Suggest next open issues to prioritize (heuristic)\r\n"]
[6.733, "o", "  meld         Plan from one or more sources and route the output\r\n"]
[6.778, "o", "  land         Close out work into VCS commits; --issue-testplan updates GH issue\r\n"]
[6.823, "o", "  todo         Manage prioritized task list (~/.dn/todo.md); 'done' marks item and closes issue\r\n"]
[6.868, "o", "  tidy         Groom todo list: re-fetch issues, re-score, update ~/.dn/todo.md\r\n"]
[6.913, "o", "  sync         Git/Sapling: lint, rebase onto main, publish local commits\r\n"]
[6.958, "o", "  runner       Pair and operate this machine as Denoise infrastructure\r\n"]
[7.003, "o", "  release      Manage GitHub releases (create, list, view, delete)\r\n"]
[7.048, "o", "\r\n"]
[7.093, "o", "Use 'dn <subcommand> --help' for subcommand-specific options.\r\n"]
[7.138, "o", "\r\n"]
[7.988, "o", ""]
[8.388, "o", "\u001b[2m# What should we work on next?\u001b[0m\r\n"]
