{
  "name": "@chesapeake/dn",
  "version": "0.0.42",
  "description": "dn cli",
  "exports": {
    ".": "./sdk/mod.ts",
    "./runner": "./sdk/runner/mod.ts",
    "./runner/types": "./sdk/runner/types.ts"
  },
  "exclude": [".opencode/", ".sl/"],
  "fmt": {
    "exclude": [
      ".cursor/skills/dn/",
      ".agents/skills/dn/",
      ".claude/skills/dn/"
    ]
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "sdk/**/*.ts",
      "docs/**/*.md",
      "docs/img/**",
      "templates/**/*.json",
      "templates/**/*.sh",
      "templates/**/*.yml",
      "kickstart/includedPrompt.ts",
      "kickstart/system.prompt.land.md",
      "kickstart/system.prompt.testplan.md"
    ],
    "exclude": []
  },
  "tasks": {
    "dev": "deno run --watch cli/main.ts",
    "lint": "deno lint --ignore=.opencode/,.sl/ **/*.ts",
    "typecheck": "deno check cli/ sdk/ kickstart/ glance/ scripts/",
    "fmt": "deno fmt **/*.ts",
    "precommit": "deno fmt && deno lint && deno task typecheck && deno task workflows:checksums --check",
    "workflows:checksums": "deno run --allow-read=templates/workflows,compile_dn.sh --allow-write=templates/workflows/manifest.json scripts/workflowChecksums.ts",
    "publish": "deno publish"
  },
  "imports": {
    "@chesapeake/obsidian-gql": "jsr:@chesapeake/obsidian-gql@^0.2.3",
    "@cursor/sdk": "npm:@cursor/sdk@^1.0.23",
    "$dax": "jsr:@david/dax@^0.45.0",
    "@libsql/client": "npm:@libsql/client@0.7.0",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@zaubrik/djwt": "jsr:@zaubrik/djwt@^3.0.2"
  }
}
